{
    "name": "Time Control",
    "version": "0.2.0",
    "description": "Slow-motion / fast-forward for the physics simulation via session.m_timeStep. Settings apply live.",
    "author": "HW Mod Manager",
    "tags": ["cheats", "physics"],
    "requires": ["game", "settings"],
    "hotToggle": true,
    "settings": [
        {
            "id": "factor",
            "type": "slider",
            "label": "Time factor",
            "default": 1,
            "min": 0.05,
            "max": 5,
            "step": 0.05,
            "unit": "x"
        }
    ]
}
