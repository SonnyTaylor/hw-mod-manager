{
    "name": "Character Editor",
    "version": "0.3.0",
    "description": "Break-limit multiplier (Normal / Tough / Iron / GOD or a custom factor), bleed stop, live limit inspector.",
    "author": "HW Mod Manager",
    "tags": ["cheats", "character"],
    "requires": ["ui", "game", "settings"],
    "hotToggle": true,
    "settings": [
        {
            "id": "preset",
            "type": "select",
            "label": "Durability",
            "default": "normal",
            "options": [
                { "value": "normal", "label": "Normal (1x)" },
                { "value": "tough", "label": "Tough (10x)" },
                { "value": "iron", "label": "Iron (100x)" },
                { "value": "god", "label": "GOD" },
                { "value": "custom", "label": "Custom (use factor)" }
            ]
        },
        {
            "id": "factor",
            "type": "slider",
            "label": "Factor",
            "default": 1,
            "min": 0.05,
            "max": 1000,
            "step": 0.05,
            "unit": "x"
        }
    ]
}
